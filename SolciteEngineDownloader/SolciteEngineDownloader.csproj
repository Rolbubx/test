<Project Sdk="Microsoft.NET.Sdk">

    <!-- SolciteEngineDownloader.exe: a tiny stand-alone installer. It downloads the latest SolciteEngine editor from the
         GitHub releases and unpacks it. Only the BCL is used, so the exe is one small file:
         dotnet publish SolciteEngineDownloader -c Release -r win-x64 -->
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AssemblyName>SolciteEngineDownloader</AssemblyName>
        <RootNamespace>SolciteEngineDownloader</RootNamespace>
        <Version>1.0.0</Version>
        <RollForward>Major</RollForward>
        <PublishSingleFile>true</PublishSingleFile>
        <SelfContained>true</SelfContained>
        <InvariantGlobalization>true</InvariantGlobalization>
        <PublishTrimmed>true</PublishTrimmed>
        <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    </PropertyGroup>

</Project>
